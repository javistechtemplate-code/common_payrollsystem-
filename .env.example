# Copy to .env (never commit .env). One Supabase project per client.
# Browser-safe values (Supabase → Project Settings → API Keys → Publishable key):
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Server-only values (Vercel → Environment Variables; used by api/*.js). Never expose in the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-secret-service-role-key
