# Copy to .env (never commit .env). One Supabase project per client — placeholders only here.

# Browser-safe values (Supabase → Project Settings → API Keys → Publishable key):
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=<your-publishable-key>
# Optional branding / login settings (defaults shown):
VITE_APP_NAME=Payroll
VITE_LOGIN_EMAIL_DOMAIN=users.example.com

# Server-only values (Vercel → Environment Variables; used by api/*.js). Never expose in the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-secret-key>
# Must match VITE_LOGIN_EMAIL_DOMAIN:
LOGIN_EMAIL_DOMAIN=users.example.com
